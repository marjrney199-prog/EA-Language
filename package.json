{
  "name": "ea-language-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma linguística premium — Aprenda. Traduza. Comunique.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -n WEB,API -c cyan,magenta \"next dev\" \"npm run dev:server\"",
    "dev:web": "next dev",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "next build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "concurrently -n WEB,API \"next start\" \"npm run start:server\"",
    "start:server": "node server/dist/index.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "export:pages": "cross-env STATIC_EXPORT=true next build",
    "firebase:deploy": "npm run export:pages && firebase deploy --only hosting",
    "prepare": "husky",
    "mobile:sync": "npm run export:pages && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "7.2.0",
    "@prisma/client": "6.7.0",
    "@reduxjs/toolkit": "2.7.0",
    "@tanstack/react-query": "5.74.4",
    "@tanstack/react-query-devtools": "5.74.4",
    "@tesseract.js-data/por": "1.0.0",
    "bcryptjs": "3.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "2.8.5",
    "docx": "9.4.1",
    "dotenv": "16.5.0",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "firebase": "11.6.1",
    "framer-motion": "12.9.2",
    "helmet": "8.1.0",
    "jose": "6.0.11",
    "jspdf": "3.0.1",
    "lucide-react": "0.503.0",
    "next": "15.5.27",
    "next-themes": "0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-redux": "9.2.0",
    "sonner": "2.0.3",
    "stripe": "18.1.0",
    "tesseract.js": "6.0.1",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@capacitor/android": "7.2.0",
    "@capacitor/cli": "7.2.0",
    "@capacitor/ios": "7.2.0",
    "@playwright/test": "1.52.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "eslint": "9.25.1",
    "eslint-config-next": "15.5.27",
    "firebase-tools": "14.2.1",
    "husky": "9.1.7",
    "postcss": "8.5.3",
    "prisma": "6.7.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "3.1.2"
  }
}
